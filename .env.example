# Optional runtime environment variables (loaded at runtime by lighthouse or Docker Compose env_file)
LIGHTHOUSE_STUN_DOMAIN=stun.example.com
LIGHTHOUSE_STUN_PORT=5349
LIGHTHOUSE_HUB_ORIGIN=wss://hub.example.com
LIGHTHOUSE_HTTPS_ADDR=:8443
LIGHTHOUSE_STUNS_ADDR=:5349
LIGHTHOUSE_POLICY=/etc/lighthouse/policy.json
LIGHTHOUSE_TLS_CERT=/etc/lighthouse/tls.crt
LIGHTHOUSE_TLS_KEY=/etc/lighthouse/tls.key
