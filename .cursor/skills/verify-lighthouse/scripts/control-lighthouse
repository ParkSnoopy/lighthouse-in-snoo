#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

die() {
  echo "control-lighthouse: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"
}

pick_free_port() {
  local exclude="${1:-}"
  local p
  for _ in $(seq 1 120); do
    p=$(( 20000 + (RANDOM % 30000) ))
    if [ -n "$exclude" ] && [ "$p" = "$exclude" ]; then
      continue
    fi
    if ! ss -H -lntu 2>/dev/null | awk '{print $5}' | grep -qE "[:.]${p}$"; then
      echo "$p"
      return 0
    fi
  done
  die "failed to allocate a free local port"
}

read_version_const() {
  sed -n 's/^const Version = "\(.*\)"/\1/p' "$REPO_ROOT/pkg/version/version.go"
}

run_clean_env() {
  local args=(env)
  while IFS='=' read -r k _; do
    case "$k" in
      LIGHTHOUSE_*) args+=(-u "$k") ;;
    esac
  done < <(env)
  "${args[@]}" "$@"
}

stop_pid_file() {
  local pidfile="$1"
  [ -f "$pidfile" ] || return 0
  local pid
  pid="$(tr -d '[:space:]' < "$pidfile")"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 30); do
      if ! kill -0 "$pid" 2>/dev/null; then
        break
      fi
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
      sleep 0.1
    fi
  fi
  rm -f "$pidfile"
}

cmd_launch() {
  require_cmd go
  require_cmd curl
  require_cmd jq
  require_cmd ss

  local run_id="lh-$(date +%Y%m%d-%H%M%S)-$$"
  local tcp_only="false"
  local insecure="false"
  local no_relay="false"
  local auto_tls="false"
  local tls_algo="ed25519"
  local evidence_base="/tmp/lighthouse-verify-evidence"

  while [ $# -gt 0 ]; do
    case "$1" in
      --run-id) run_id="$2"; shift 2 ;;
      --tcp-only) tcp_only="true"; shift ;;
      --insecure) insecure="true"; shift ;;
      --no-relay) no_relay="true"; shift ;;
      --auto-tls) auto_tls="true"; shift ;;
      --tls-algo) tls_algo="$2"; shift 2 ;;
      --evidence-dir) evidence_base="$2"; shift 2 ;;
      *) die "unknown launch option: $1" ;;
    esac
  done

  if [ "$auto_tls" != "true" ]; then
    require_cmd openssl
  fi

  local run_dir="/tmp/lighthouse-verify-${run_id}"
  local evidence_dir="${evidence_base}/${run_id}"
  if [ -e "$run_dir" ]; then
    die "run dir already exists: $run_dir (choose a fresh --run-id or clean it up)"
  fi

  mkdir -p "$run_dir"/{bin,tls,logs,pids}
  mkdir -p "$evidence_dir"

  local hub_bin="$run_dir/bin/lighthouse"
  local ui_bin="$run_dir/bin/lighthouse-ui"
  (cd "$REPO_ROOT" && CGO_ENABLED=0 GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o "$hub_bin" ./cmd/lighthouse)

  local ui_tags=()
  if ! pkg-config --exists xxf86vm 2>/dev/null; then
    ui_tags=(-tags wayland)
  fi
  (cd "$REPO_ROOT" && go build "${ui_tags[@]}" -trimpath -ldflags="-s -w" -o "$ui_bin" ./cmd/lighthouse-ui)

  local ca_cert=""
  if [ "$auto_tls" != "true" ]; then
    openssl ecparam -name prime256v1 -genkey -noout -out "$run_dir/tls/ca.key" 2>/dev/null
    openssl req -x509 -new -key "$run_dir/tls/ca.key" -sha256 -days 1 \
      -subj "/CN=lighthouse-verify-ca" \
      -addext "basicConstraints=critical,CA:TRUE" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
      -out "$run_dir/tls/ca.crt" 2>/dev/null

    openssl ecparam -name prime256v1 -genkey -noout -out "$run_dir/tls/server.key" 2>/dev/null
    openssl req -new -key "$run_dir/tls/server.key" -subj "/CN=localhost" -out "$run_dir/tls/server.csr" 2>/dev/null
    cat > "$run_dir/tls/ext.cnf" <<'EOF'
basicConstraints=CA:FALSE
keyUsage=digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=IP:127.0.0.1,DNS:localhost
EOF
    openssl x509 -req -in "$run_dir/tls/server.csr" -CA "$run_dir/tls/ca.crt" -CAkey "$run_dir/tls/ca.key" \
      -CAcreateserial -days 1 -sha256 -extfile "$run_dir/tls/ext.cnf" -out "$run_dir/tls/server.crt" 2>/dev/null
    chmod 0600 "$run_dir/tls/ca.key" "$run_dir/tls/server.key"
    ca_cert="$run_dir/tls/ca.crt"
  fi

  local https_port stuns_port stun_insecure_port=""
  https_port="$(pick_free_port)"
  stuns_port="$(pick_free_port "$https_port")"
  if [ "$insecure" = "true" ]; then
    stun_insecure_port="$(pick_free_port "$stuns_port")"
    while [ "$stun_insecure_port" = "$https_port" ]; do
      stun_insecure_port="$(pick_free_port "$stuns_port")"
    done
  fi

  local hub_origin="wss://127.0.0.1:${https_port}"
  local hub_url="${hub_origin}/v1/signal"
  local stuns_uri="stuns:127.0.0.1:${stuns_port}"

  local hub_args=(
    hub
    --https-addr "127.0.0.1:${https_port}"
    --stuns-addr "127.0.0.1:${stuns_port}"
    --hub-origin "$hub_origin"
  )
  if [ "$auto_tls" != "true" ]; then
    hub_args+=(--tls-cert "$run_dir/tls/server.crt" --tls-key "$run_dir/tls/server.key")
  else
    hub_args+=(--tls-algo "$tls_algo")
  fi
  if [ "$tcp_only" = "true" ]; then
    hub_args+=(--tcp-only)
  fi
  if [ "$insecure" = "true" ]; then
    hub_args+=(--insecure --stun-addr "127.0.0.1:${stun_insecure_port}")
  fi
  if [ "$no_relay" = "true" ]; then
    hub_args+=(--no-relay)
  fi

  (
    cd "$run_dir"
    run_clean_env "$hub_bin" "${hub_args[@]}" >"$run_dir/logs/hub.out" 2>"$run_dir/logs/hub.log" &
    echo $! > "$run_dir/pids/hub.pid"
  )
  local hub_pid
  hub_pid="$(cat "$run_dir/pids/hub.pid")"

  local curl_tls_args=(--tlsv1.3 --tls-max 1.3)
  if [ "$auto_tls" = "true" ]; then
    curl_tls_args+=(-k)
  else
    curl_tls_args+=(--cacert "$ca_cert")
  fi

  local ready="false"
  for _ in $(seq 1 100); do
    if ! kill -0 "$hub_pid" 2>/dev/null; then
      cat "$run_dir/logs/hub.log" >&2 || true
      rm -rf "$run_dir"
      die "hub process exited before becoming ready"
    fi
    if grep -q '"msg":"lighthouse hub started"' "$run_dir/logs/hub.log" 2>/dev/null; then
      local body
      body="$(curl "${curl_tls_args[@]}" -fsS "https://127.0.0.1:${https_port}/healthz" 2>/dev/null || true)"
      if [ "$body" = '{"status":"ok"}' ]; then
        ready="true"
        break
      fi
    fi
    sleep 0.1
  done

  if [ "$ready" != "true" ]; then
    stop_pid_file "$run_dir/pids/hub.pid"
    cat "$run_dir/logs/hub.log" >&2 || true
    rm -rf "$run_dir"
    die "hub failed readiness check within timeout"
  fi

  local hub_ver ui_ver
  hub_ver="$(run_clean_env "$hub_bin" --version | awk '{print $2}')"
  ui_ver="$(run_clean_env "$ui_bin" --version | awk '{print $2}')"

  jq -n \
    --arg run_id "$run_id" \
    --arg run_dir "$run_dir" \
    --arg evidence_dir "$evidence_dir" \
    --arg hub_binary "$hub_bin" \
    --arg ui_binary "$ui_bin" \
    --arg version "$hub_ver" \
    --arg ui_version "$ui_ver" \
    --arg hub_pid "$hub_pid" \
    --argjson https_port "$https_port" \
    --argjson stuns_port "$stuns_port" \
    --arg stun_insecure_port "$stun_insecure_port" \
    --arg hub_origin "$hub_origin" \
    --arg hub_url "$hub_url" \
    --arg stuns_uri "$stuns_uri" \
    --arg ca_cert "$ca_cert" \
    --argjson tcp_only "$tcp_only" \
    --argjson insecure "$insecure" \
    --argjson no_relay "$no_relay" \
    --argjson auto_tls "$auto_tls" \
    --arg tls_algo "$tls_algo" \
    '{
      run_id: $run_id,
      run_dir: $run_dir,
      evidence_dir: $evidence_dir,
      hub_binary: $hub_binary,
      ui_binary: $ui_binary,
      version: $version,
      ui_version: $ui_version,
      hub_pid: ($hub_pid | tonumber),
      https_port: $https_port,
      stuns_port: $stuns_port,
      stun_insecure_port: (if $stun_insecure_port == "" then null else ($stun_insecure_port | tonumber) end),
      hub_origin: $hub_origin,
      hub_url: $hub_url,
      stuns_uri: $stuns_uri,
      ca_cert: (if $ca_cert == "" then null else $ca_cert end),
      tcp_only: $tcp_only,
      insecure: $insecure,
      no_relay: $no_relay,
      auto_tls: $auto_tls,
      tls_algo: $tls_algo
    }' > "$run_dir/state.json"

  cat "$run_dir/state.json"
}

cmd_doctor() {
  require_cmd curl
  require_cmd jq
  require_cmd ss

  local run_dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-dir) run_dir="$2"; shift 2 ;;
      *) die "unknown doctor option: $1" ;;
    esac
  done
  [ -n "$run_dir" ] || die "doctor requires --run-dir <DIR>"
  [ -f "$run_dir/state.json" ] || die "missing $run_dir/state.json"

  local hub_bin ui_bin hub_pid https_port stuns_port ca_cert tcp_only insecure auto_tls stun_insecure_port
  hub_bin="$(jq -r '.hub_binary' "$run_dir/state.json")"
  ui_bin="$(jq -r '.ui_binary' "$run_dir/state.json")"
  hub_pid="$(jq -r '.hub_pid' "$run_dir/state.json")"
  https_port="$(jq -r '.https_port' "$run_dir/state.json")"
  stuns_port="$(jq -r '.stuns_port' "$run_dir/state.json")"
  ca_cert="$(jq -r '.ca_cert // empty' "$run_dir/state.json")"
  tcp_only="$(jq -r '.tcp_only' "$run_dir/state.json")"
  insecure="$(jq -r '.insecure' "$run_dir/state.json")"
  auto_tls="$(jq -r '.auto_tls' "$run_dir/state.json")"
  stun_insecure_port="$(jq -r '.stun_insecure_port // empty' "$run_dir/state.json")"

  local ok="true"
  local issues=()

  if ! kill -0 "$hub_pid" 2>/dev/null; then
    ok="false"
    issues+=("hub pid $hub_pid is not running")
  elif [ -r "/proc/${hub_pid}/cmdline" ] && ! tr '\0' ' ' < "/proc/${hub_pid}/cmdline" | grep -Fq "$hub_bin"; then
    ok="false"
    issues+=("pid $hub_pid does not match binary $hub_bin")
  fi

  local source_ver hub_ver ui_ver
  source_ver="$(read_version_const)"
  hub_ver="$(run_clean_env "$hub_bin" --version | awk '{print $2}')"
  ui_ver="$(run_clean_env "$ui_bin" --version | awk '{print $2}')"
  if [ "$source_ver" != "$hub_ver" ] || [ "$source_ver" != "$ui_ver" ]; then
    ok="false"
    issues+=("version mismatch: pkg/version=$source_ver lighthouse=$hub_ver lighthouse-ui=$ui_ver")
  fi

  local tcp_sockets udp_sockets
  tcp_sockets="$(ss -H -lntp 2>/dev/null | grep "pid=${hub_pid}," || true)"
  udp_sockets="$(ss -H -lnup 2>/dev/null | grep "pid=${hub_pid}," || true)"

  if ! grep -q "127.0.0.1:${https_port}" <<<"$tcp_sockets"; then
    ok="false"
    issues+=("hub pid $hub_pid does not own TCP 127.0.0.1:${https_port}")
  fi

  if [ "$tcp_only" = "true" ]; then
    if [ -n "$udp_sockets" ]; then
      ok="false"
      issues+=("tcp-only hub unexpectedly bound UDP sockets: $udp_sockets")
    fi
    if ! grep -q "127.0.0.1:${stuns_port}" <<<"$tcp_sockets"; then
      ok="false"
      issues+=("tcp-only hub does not own TLS/TCP STUNS 127.0.0.1:${stuns_port}")
    fi
  else
    if ! grep -q "127.0.0.1:${stuns_port}" <<<"$udp_sockets"; then
      ok="false"
      issues+=("hub does not own DTLS/UDP STUNS/TURNS 127.0.0.1:${stuns_port}")
    fi
  fi

  if [ "$insecure" = "true" ] && [ -n "$stun_insecure_port" ]; then
    if [ "$tcp_only" = "true" ]; then
      if ! grep -q "127.0.0.1:${stun_insecure_port}" <<<"$tcp_sockets"; then
        ok="false"
        issues+=("insecure tcp-only hub missing TCP 127.0.0.1:${stun_insecure_port}")
      fi
    else
      if ! grep -q "127.0.0.1:${stun_insecure_port}" <<<"$udp_sockets"; then
        ok="false"
        issues+=("insecure hub missing UDP 127.0.0.1:${stun_insecure_port}")
      fi
    fi
  fi

  local curl_ca_args=()
  if [ "$auto_tls" = "true" ] || [ -z "$ca_cert" ]; then
    curl_ca_args=(-k)
  else
    curl_ca_args=(--cacert "$ca_cert")
  fi

  local health_body tls12_rejected="false"
  health_body="$(curl --tlsv1.3 --tls-max 1.3 "${curl_ca_args[@]}" -fsS "https://127.0.0.1:${https_port}/healthz" 2>/dev/null || true)"
  if [ "$health_body" != '{"status":"ok"}' ]; then
    ok="false"
    issues+=("TLS 1.3 /healthz failed (body=$health_body)")
  fi
  if curl --tlsv1.2 --tls-max 1.2 "${curl_ca_args[@]}" -fsS "https://127.0.0.1:${https_port}/healthz" >/dev/null 2>&1; then
    ok="false"
    issues+=("TLS 1.2 /healthz unexpectedly succeeded")
  else
    tls12_rejected="true"
  fi

  local issues_json="[]"
  if [ "${#issues[@]}" -gt 0 ]; then
    issues_json="$(printf '%s\n' "${issues[@]}" | jq -R . | jq -s .)"
  fi

  jq -n \
    --argjson healthy "$ok" \
    --arg run_dir "$run_dir" \
    --arg version "$hub_ver" \
    --arg ui_version "$ui_ver" \
    --argjson hub_pid "$hub_pid" \
    --argjson https_port "$https_port" \
    --argjson stuns_port "$stuns_port" \
    --argjson tcp_only "$tcp_only" \
    --argjson auto_tls "$auto_tls" \
    --argjson tls12_rejected "$tls12_rejected" \
    --argjson udp_socket_count "$(printf '%s' "$udp_sockets" | grep -c . || true)" \
    --argjson issues "$issues_json" \
    '{
      healthy: $healthy,
      run_dir: $run_dir,
      version: $version,
      ui_version: $ui_version,
      hub_pid: $hub_pid,
      https_port: $https_port,
      stuns_port: $stuns_port,
      tcp_only: $tcp_only,
      auto_tls: $auto_tls,
      tls12_rejected: $tls12_rejected,
      hub_udp_sockets: $udp_socket_count,
      issues: $issues
    }'

  [ "$ok" = "true" ]
}

cmd_cli() {
  local run_dir="" capture_rel="" target_bin="hub"
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-dir) run_dir="$2"; shift 2 ;;
      --bin) target_bin="$2"; shift 2 ;;
      --capture) capture_rel="$2"; shift 2 ;;
      --) shift; break ;;
      *) die "unknown cli option: $1 (pass '--' before arguments)" ;;
    esac
  done
  [ -n "$run_dir" ] || die "cli requires --run-dir <DIR>"
  [ $# -gt 0 ] || die "cli requires arguments after '--'"

  local bin label evidence_dir
  case "$target_bin" in
    hub)
      bin="$(jq -r '.hub_binary' "$run_dir/state.json")"
      label="lighthouse"
      ;;
    ui)
      bin="$(jq -r '.ui_binary' "$run_dir/state.json")"
      label="lighthouse-ui"
      ;;
    *) die "invalid --bin value '$target_bin' (expected hub or ui)" ;;
  esac
  evidence_dir="$(jq -r '.evidence_dir' "$run_dir/state.json")"

  local tmp_out tmp_err rc=0
  tmp_out="$(mktemp "$run_dir/logs/cli-out.XXXXXX")"
  tmp_err="$(mktemp "$run_dir/logs/cli-err.XXXXXX")"
  (cd "$run_dir" && run_clean_env "$bin" "$@") >"$tmp_out" 2>"$tmp_err" || rc=$?

  cat "$tmp_out"
  cat "$tmp_err" >&2

  if [ -n "$capture_rel" ]; then
    local dst="$evidence_dir/$capture_rel"
    mkdir -p "$(dirname "$dst")"
    {
      echo "command: $label $*"
      echo "exit_code: $rc"
      echo "--- stdout ---"
      cat "$tmp_out"
      echo "--- stderr ---"
      cat "$tmp_err"
    } > "$dst"
  fi
  rm -f "$tmp_out" "$tmp_err"
  return "$rc"
}

cmd_capture() {
  local run_dir="" feature="" note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-dir) run_dir="$2"; shift 2 ;;
      --feature) feature="$2"; shift 2 ;;
      --note) note="$2"; shift 2 ;;
      *) die "unknown capture option: $1" ;;
    esac
  done
  [ -n "$run_dir" ] || die "capture requires --run-dir <DIR>"
  [ -n "$feature" ] || die "capture requires --feature <ID>"

  local evidence_dir dst
  evidence_dir="$(jq -r '.evidence_dir' "$run_dir/state.json")"
  dst="$evidence_dir/$feature"
  mkdir -p "$dst"

  cp "$run_dir/state.json" "$dst/state.json"
  cp -a "$run_dir/logs/." "$dst/" 2>/dev/null || true

  local pid_regex=""
  for pf in "$run_dir"/pids/*.pid; do
    [ -f "$pf" ] || continue
    local p
    p="$(tr -d '[:space:]' < "$pf")"
    [ -n "$p" ] || continue
    if [ -z "$pid_regex" ]; then
      pid_regex="pid=${p},"
    else
      pid_regex="${pid_regex}|pid=${p},"
    fi
  done
  if [ -n "$pid_regex" ]; then
    ss -H -lntup 2>/dev/null | grep -E "$pid_regex" > "$dst/sockets.txt" || true
  else
    : > "$dst/sockets.txt"
  fi

  if [ -n "$note" ]; then
    printf '%s\n' "$note" > "$dst/note.txt"
  fi
  jq -n --arg evidence_path "$dst" --arg feature "$feature" '{captured: true, feature: $feature, path: $evidence_path}'
}

cmd_cleanup() {
  local run_dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --run-dir) run_dir="$2"; shift 2 ;;
      *) die "unknown cleanup option: $1" ;;
    esac
  done
  [ -n "$run_dir" ] || die "cleanup requires --run-dir <DIR>"
  [ -d "$run_dir" ] || { echo '{"cleaned":true,"note":"run_dir already absent"}'; return 0; }

  local evidence_dir=""
  if [ -f "$run_dir/state.json" ]; then
    evidence_dir="$(jq -r '.evidence_dir' "$run_dir/state.json")"
  fi

  for pf in "$run_dir"/pids/*.pid; do
    [ -f "$pf" ] || continue
    stop_pid_file "$pf"
  done

  rm -rf "$run_dir"
  jq -n --arg run_dir "$run_dir" --arg evidence_dir "$evidence_dir" \
    '{cleaned: true, removed_run_dir: $run_dir, preserved_evidence_dir: $evidence_dir}'
}

usage() {
  cat <<'EOF'
Usage: control-lighthouse <command> [options]

Commands:
  launch      Build lighthouse + lighthouse-ui and start an isolated zero-config hub
  doctor      Read-only health check (PID, version alignment, sockets, TLS 1.3 vs 1.2)
  cli         Run isolated lighthouse or lighthouse-ui CLI command with optional proof capture
  capture     Snapshot logs, state, and run-owned sockets into evidence dir
  cleanup     Stop tracked PIDs and delete run dir while preserving evidence dir
EOF
}

case "${1:-}" in
  launch) shift; cmd_launch "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  cli) shift; cmd_cli "$@" ;;
  capture) shift; cmd_capture "$@" ;;
  cleanup) shift; cmd_cleanup "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown command: $1" ;;
esac
